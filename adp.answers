# ADP answers — fill the values, then run:  scripts/adp-fill.sh .   (or: node scripts/adp-fill.mjs .)
#
# SYNTAX
#   KEY=value          one per line; everything after the FIRST '=' is the value
#   # ...              lines starting with '#' are comments (the "e.g." hints below) — ignored
#   KEY=               leave blank to skip a key (fill it later by hand)
#   No quotes needed. Spaces and commas are fine. Put multi-item values (paths, lists)
#   comma-separated on ONE line. Keep each value to a single line.
#
# NOTE: this file does NOT include codebase_index.txt — that's auto-generated by
#       scripts/generate_map.py (never hand-filled). Run it after install.
#       generate_map.py currently indexes PYTHON (.py) only; JS/TS/HTML/other are not
#       indexed. The codebase index is optional — the rest of ADP is language-agnostic.
#
# Tip: the ownership lanes (DEV_/DESIGN_OWNED_PATHS, DO_NOT_TOUCH) are a design
# decision — set them deliberately, or leave blank and let a first architect
# session (docs/prompts/initialize.md) propose them.

# --- Core (most installs need these) ---------------------------------------
# e.g.  TaskFlow — internal tool for tracking client work
PROJECT_NAME=SIMAC Prep — préparation de rendez-vous commerciaux (SIMAC / SONCAS) pour TPE-PME, gratuite, statique, IA au choix (BYOK)
# e.g.  Python 3.12 + FastAPI + Postgres (backend); React 18 + TypeScript + Vite (frontend)
STACK=HTML + CSS + JavaScript ES modules, sans build ; IA via endpoints OpenAI-compatibles (Groq, Gemini, Mistral, OpenRouter, Ollama) ; stockage localStorage + CSV
# e.g.  docker compose up   (api :8000, web :5173, db :5432)
LOCAL_RUN=npm run serve   (python3 -m http.server 8765 --directory web) → http://localhost:8765
# e.g.  GitHub Actions on push to main -> Fly.io
DEPLOY=GitHub Actions on push to main → GitHub Pages (.github/workflows/pages.yml, publie web/)
# e.g.  pytest tests/ -q
TEST_CMD=npm test   (Playwright, parcours complet en mode démo, serveur :8765 requis)
# 3-7 timeless rules, one sentence each. e.g.  1) DB access only via repos/. 2) Secrets from env, never hardcoded. 3) Endpoints return Pydantic schemas.
ARCH_RULES=1) Zéro backend, zéro dépendance runtime : tout tourne dans le navigateur. 2) Un seul protocole LLM : POST /chat/completions OpenAI-compatible ; ajouter un fournisseur = une entrée PROVIDERS dans web/lib/llm.js. 3) Toute sortie IA est du JSON demandé par schéma dans le prompt et parsée par parseJSON ; jamais de texte libre. 4) La méthode de vente vit dans docs/METHODE.md et se reflète dans web/lib/prompts.js — modifier l'un impose l'autre. 5) Le CSV (COLUMNS de store.js) est le contrat de données : toute nouvelle donnée de RDV s'ajoute en colonne, jamais en structure imbriquée. 6) Les rendus asynchrones vérifient S.step avant de toucher au DOM. 7) Jamais de clé ni de secret dans le code ; la clé utilisateur reste en localStorage.
# internal acronyms / codenames a fresh session should know. e.g.  Dispatch=the pickup block; Lane=a role's owned paths
GLOSSARY=SIMAC=Situation Idée Mécanisme Avantages Conclusion ; SONCAS-E=Sécurité Orgueil Nouveauté Confort Argent Sympathie Environnement (code Y pour Sympathie) ; CABP=Caractéristique Avantage Bénéfice Preuve ; CTA=appel à l'action convenu (action, responsable, date, livrable) ; BYOK=l'utilisateur apporte sa clé d'IA ; mode démo=fournisseur mock sans réseau

# --- Developer lane ---------------------------------------------------------
# LANES ARE FOR YOUR PRODUCT CODE DIRS ONLY. Do NOT list ANY ADP-installed path here
# (docs/tasks/, docs/plans/, docs/prompts/, docs/skills/, memory/, .adp/,
# .agentic-protocol/, .claude/, .github/workflows/) — they're governed by process.md §4.
# current.md + .adp/ are co-edited/machine-managed; locking them breaks the flow.
# comma-separated CODE paths this role OWNS. e.g.  api/, db/, tests/, scripts/
DEV_OWNED_PATHS=web/lib/, tests/, package.json
# CODE paths this role must NOT edit (usually the other roles' code). e.g.  web/, .github/
DEV_DO_NOT_TOUCH=web/index.html, web/styles.css, web/app.js, .github/

# --- Designer lane (delete/skip if no UI) -----------------------------------
# e.g.  web/src/, web/public/locales/, web/tests/e2e/
DESIGN_OWNED_PATHS=web/index.html, web/styles.css, web/app.js
# e.g.  api/, db/, scripts/
DESIGN_DO_NOT_TOUCH=web/lib/, tests/, .github/
# e.g.  React 18 + TypeScript + Tailwind, built with Vite
UI_STACK=HTML + CSS custom properties + JavaScript vanilla (rendu par template strings), sans framework ni build
# where design tokens live. e.g.  web/src/styles/tokens.css
DESIGN_TOKENS=web/styles.css (:root — couleurs, rayon, police ; thème sombre via prefers-color-scheme)
# e.g.  en, fr, es   (or:  en only — no i18n yet)
I18N_LOCALES=fr (interface) ; prompts fr + en dans web/lib/prompts.js — en UI à venir
# e.g.  npm --prefix web run build
BUILD_CMD=aucun build — fichiers statiques servis tels quels
# end-to-end test command. e.g.  npm run test:e2e
E2E_CMD=npm test
# e.g.  #2563EB (blue-600)
COLOR_PRIMARY=#0f766e (teal) ; sombre #2dd4bf
# e.g.  #DC2626 (red-600)
COLOR_DANGER=#b91c1c
# e.g.  Inter; 12/14/16/20/24/32px
TYPE_SCALE=system-ui ; 12/13/14/15/17/18/22px
# e.g.  4px base: 4/8/12/16/24/32/48
SPACING_SCALE=4px base : 4/6/8/10/12/16/22/28
# e.g.  web/src/components/
COMPONENT_DIR=web/app.js (renderers.<step>) — un renderer par étape
# e.g.  PascalCase.tsx + co-located PascalCase.test.tsx
COMPONENT_FILE_CONVENTION=fonctions renderX() + template strings ; liaison par data-bind="objet.champ"
# e.g.  TanStack Query for server state; React Context for theme only
STATE_CONVENTION=un objet d'état S (brouillon) persisté dans localStorage simac.draft ; mémoire des RDV dans simac.meetings via web/lib/store.js

# --- Operational quick-ref skill --------------------------------------------
# 2-3 lines on the architecture. e.g.  3-tier: React SPA -> FastAPI REST -> Postgres; JWT auth
ARCHITECTURE_SUMMARY=SPA statique → appels directs du navigateur aux API LLM gratuites (BYOK) et à Jina Reader ; données en localStorage, export/import CSV = base RAG. Voir docs/ARCHITECTURE.md
# e.g.  api/main.py
BACKEND_ENTRY=aucun backend
# e.g.  web/src/main.tsx
FRONTEND_ENTRY=web/app.js
# e.g.  api/config.py, .env.example
CONFIG_PATHS=web/lib/llm.js (PROVIDERS) ; réglages utilisateur en localStorage simac.llm.settings
# e.g.  db/migrations/
MIGRATIONS_PATH=aucune base — schéma CSV : COLUMNS dans web/lib/store.js
# e.g.  .github/workflows/
CI_PATH=.github/workflows/
# run ONE test. e.g.  pytest tests/test_<module>.py::<test> -q
TEST_ONE_CMD=node tests/e2e.mjs (un seul parcours pour l'instant)
# e.g.  ruff check . && ruff format --check .
LINT_CMD=node --check web/app.js web/lib/*.js
# e.g.  flyctl deploy
DEPLOY_CMD=git push origin main (Pages se déploie seul)
# one common gotcha a new session should know. e.g.  the emulator caches modules — restart after a pull (Gate 0)
GOTCHA_1=Le test e2e attend un serveur sur :8765 ; les réponses IA arrivant après un changement d'étape ne doivent pas re-rendre l'étape précédente (garde S.step)

# --- Business / comms / analyst (skip if not using those roles) -------------
# e.g.  small-team leads tracking work across projects
TARGET_USER=indépendants et TPE/PME (1-50 personnes) qui vendent eux-mêmes, sans équipe commerciale
# one line on what the product does. e.g.  TaskFlow helps small teams dispatch and track work without ceremony.
USER_BRIEF=SIMAC Prep aide un dirigeant de petite entreprise à préparer un rendez-vous de vente en 20 minutes (fiche client, persona SONCAS, script SIMAC, objections) puis à le suivre avec un appel à l'action daté — gratuitement.
# e.g.  docs/operations/feedback-log.md
FEEDBACK_LOG_PATH=docs/operations/feedback-log.md
# one file stating voice + claims you may / may not make. e.g.  docs/brand.md
BRAND_CANON_PATH=docs/METHODE.md
# dirs the comms role may write. e.g.  docs/marketing/, docs/operations/investor/
CONTENT_LANES=docs/marketing/

# --- Contract-enforcement & design-principles skill detail (optional) -------
# a domain rule + how to check it. e.g.  DOMAIN_RULE_1=all timestamps stored UTC  /  HOW_TO_CHECK_1=grep for naive datetimes in api/
DOMAIN_RULE_1=Le prix n'apparaît qu'en dernière étape du Mécanisme, jamais avant
HOW_TO_CHECK_1=relire web/lib/prompts.js (simacMessages) et un SIMAC généré : la ligne prix est la dernière du mécanisme
DOMAIN_RULE_2=Chaque avantage reformule un besoin du client (« (besoin : …) »)
HOW_TO_CHECK_2=chaque ligne d'advantages contient '(besoin'
DOMAIN_RULE_3=Aucun fait client inventé : ce qui n'est pas sourcé est une hypothèse
HOW_TO_CHECK_3=la fiche client sépare facts (avec source) et assumptions ; vérifier sur une génération
# a UI invariant + why. e.g.  UI_INVARIANT_1=prices always show currency + VAT state  /  WHY_1=post-launch audit found ambiguous totals
UI_INVARIANT_1=Les scores SONCAS restent modifiables par l'utilisateur après la proposition IA, et l'écart IA/utilisateur est visible
WHY_1=la méthode dit que SONCAS explore des motivations, pas des types figés : l'humain tranche
